NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXTAUTH_SECRET=your-secret
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_MOCK_COMPREGEN=false
DATABASE_URL=postgresql://your-username:your-password@your-host:your-port/your-database
COMPREGEN_ADMIN_API_KEY=compregen-admin-secret-key-dev

# Google OAuth (NextAuth GoogleProvider) — see Backend-2026/.env.example
# for the Google Cloud Console setup steps. The frontend needs BOTH the
# client ID and the client secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
